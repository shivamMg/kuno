[Unit]
Description=Kuno durable training run
Requires=kuno-blobfuse2.service
After=kuno-blobfuse2.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/kuno-training.env
StartLimitIntervalSec=1h
StartLimitBurst=__MAX_RESTARTS__

[Service]
Type=simple
User=__SERVICE_USER__
SupplementaryGroups=docker
EnvironmentFile=/etc/kuno-training.env
ExecStart=/usr/local/bin/run-training.sh
ExecStopPost=-/usr/bin/docker rm -f kuno-training
KillMode=control-group
TimeoutStopSec=120
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=0 78

[Install]
WantedBy=multi-user.target
