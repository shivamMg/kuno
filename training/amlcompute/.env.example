AML_COMPUTE_RESOURCE_IDS=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>/computes/<preferred-compute>,/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.MachineLearningServices/workspaces/<workspace>/computes/<fallback-compute>
STORAGE_ACCOUNT_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
STORAGE_CONTAINER=<container>
AML_SSH_USER=<user>
AML_SSH_PASSWORD=<password>

# Required for real training; dry runs default to run_dry_run when omitted.
KUNO_RUN_ID=run_<run-id>
KUNO_IMAGE=<registry>/<repository>@sha256:<digest>
# Used only to pull a missing image and removed from the node after the pull.
ACR_USERNAME=<registry-user>
ACR_PASSWORD=<registry-password>
KUNO_DURABLE_PATH=/mnt/kuno-training
KUNO_LOCAL_PATH=/mnt/kuno-local
KUNO_SERVICE_USER=<user>
KUNO_TRAINING_ENABLED=false
KUNO_DRY_RUN_STEPS=3
KUNO_DRY_RUN_INTERVAL_SECONDS=1
# Must resolve on the node host and inside the container; keep it under KUNO_DURABLE_PATH.
KUNO_CONFIG_PATH=<config-path-under-durable-mount>
KUNO_CONFIG_HASH=<sha256>
KUNO_PROGRESS_TIMEOUT_SECONDS=600